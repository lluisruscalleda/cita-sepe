# --- Dades de la sol·licitud / Datos de la solicitud ---
SEPE_CODIGO_POSTAL=08330
SEPE_NIF=YOUR_NIF
SEPE_TIPO_OFICINA=146
SEPE_TRAMIT=158
SEPE_SUBTRAMIT=8
SEPE_CANAL=1

# Interval entre consultes (ms). Per defecte 5 minuts.
POLL_INTERVAL_MS=300000

# true = navegador invisible; false = amb finestra (debug)
HEADLESS=true

# URL del portal (l'iframe de citaprevia es resol automàticament)
SEPE_PORTAL_URL=https://sede.sepe.gob.es/portalSede/ca/procedimientos-y-servicios/personas/proteccion-por-desempleo/cita-previa/cita-previa-solicitud.html
SEPE_DIRECT_URL=https://citaprevia-sede.sepe.gob.es/citapreviasepe/?origen=sepe&codidioma=ca

# Directori local de buckets (fallback i cache)
BUCKETS_DIR=./buckets

# Reintents amb backoff davant errors transitòris
MAX_RETRIES=3
RETRY_BASE_MS=5000

# --- Notificacions (opcional) ---
# Només s'envien quan l'estat passa a "available" (hi ha cites).
# NOTIFY_ON_EVERY_AVAILABLE=true → també a cada cicle mentre hi hagi cites
NOTIFY_ON_EVERY_AVAILABLE=false

# ntfy.sh — URL del topic (ex: https://ntfy.sh/cita-sepe-meu-topic-secret)
NOTIFY_NTFY_URL=

# Pushover — https://pushover.net/
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# Webhook HTTP POST (JSON) quan hi ha disponibilitat
NOTIFY_WEBHOOK_URL=

# Telegram (opcional): bot token + chat id
# NOTIFY_TELEGRAM_BOT_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=

# --- Google Drive (opcional; sense això només desa local) ---
# ID de la carpeta Drive on crear buckets/YYYY-MM-DD/HH-MM-SS/
GOOGLE_DRIVE_FOLDER_ID=

# Camí a un JSON de compte de servei (o deixa GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# Alternativa: contingut JSON del compte de servei en una sola línia
# GOOGLE_DRIVE_CREDENTIALS_JSON=
